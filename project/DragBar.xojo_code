#tag Class
Protected Class DragBar
Inherits DesktopCanvas
	#tag Event
		Function MouseDown(x As Integer, y As Integer) As Boolean
		  // if IsContextualClick() then
		  // 
		  // return false
		  // 
		  // end if
		  
		  me.startX = X
		  
		  me.startY = Y
		  
		  me.lastX = X
		  
		  me.lastY = Y
		  
		  return true
		  
		End Function
	#tag EndEvent

	#tag Event
		Sub MouseDrag(x As Integer, y As Integer)
		  if me.lastX = X and me.lastY = Y then return
		  
		  me.lastX = X
		  
		  me.lastY = Y
		  
		  var bg as ContainerBG = ContainerBG( me.Parent )
		  
		  var cc as DesktopContainerNode = DesktopContainerNode( bg.Parent )
		  
		  cc.Left = cc.Left + me.lastX - me.startX
		  
		  cc.Top = cc.Top + me.lastY - me.startY
		  
		  self.Window.Refresh()
		  
		  
		End Sub
	#tag EndEvent


	#tag Property, Flags = &h21
		Private lastX As Integer
	#tag EndProperty

	#tag Property, Flags = &h21
		Private lastY As Integer
	#tag EndProperty

	#tag Property, Flags = &h21
		Private startX As Integer
	#tag EndProperty

	#tag Property, Flags = &h21
		Private startY As Integer
	#tag EndProperty


