#tag WindowCode
	#tag Event
		Sub Opening()
		  self.Title = self.Title.ReplaceAll( "uuidSource" , self.sourceCC.uuid.ToString() )
		  
		  self.Title = self.Title.ReplaceAll( "uuidTarget" , self.targetCC.uuid.ToString() )
		  
		  var weight as Double = self.targetCC.getWeightForInputCC( self.sourceCC )
		  
		  self.TextFieldWeight.Text = weight.ToString()
		  
		  
		End Sub
	#tag EndEvent


	#tag Method, Flags = &h0
		Shared Sub closeFor(source as DesktopContainerNode, target as DesktopContainerNode)
		  for each w as DesktopWindow in App.Windows()
		    
		    if w isA WindowWeightInspector then
		      
		      if WindowWeightInspector( w ).sourceCC = source and WindowWeightInspector( w ).targetCC = target then
		        
		        w.Close()
		        
		        return
		        
		      end if
		      
		    end if
		    
		  next
		  
		  
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub Constructor(source as DesktopContainerNode, target as ContainerPerceptron)
		  self.sourceCC = source
		  self.targetCC = target
		  
		  super.Constructor( self.targetCC )
		  
		  
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Shared Sub openFor(source as DesktopContainerNode, target as ContainerPerceptron)
		  for each w as DesktopWindow in App.Windows()
		    
		    if w isA WindowWeightInspector then
		      
		      if WindowWeightInspector( w ).sourceCC = source and WindowWeightInspector( w ).targetCC = target then
		        
		        w.Show()
		        
		        return
		        
		      end if
		      
		    end if
		    
		  next
		  
		  var w as WindowWeightInspector = new WindowWeightInspector( source, target )
		  
		  #pragma unused w
		  
		End Sub
	#tag EndMethod


	#tag Property, Flags = &h0
		sourceCC As DesktopContainerNode
	#tag EndProperty

	#tag Property, Flags = &h0
		targetCC As ContainerPerceptron
	#tag EndProperty


#tag EndWindowCode

#tag Events ButtonApply
	#tag Event
		Sub Pressed()
		  var newValue as Double = val( self.TextFieldWeight.Text )
		  
		  self.targetCC.setNewWeightForCC( self.sourceCC, newValue )
		  
		  
		End Sub
	#tag EndEvent
#tag EndEvents
